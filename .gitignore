# ============================================================
# Vivado project .gitignore
#
# What belongs in this repository: RTL sources, the block design,
# the rebuild script, the post-implementation reports and the
# documentation. Everything Vivado can regenerate is excluded.
# ============================================================

# --- Vivado logs and journals -------------------------------
*.jou
*.log
*.str
*.xpe
*.backup.jou
*.backup.log
usage_statistics_webtalk.*
webtalk/
.Xil/

# --- Vivado generated project directories -------------------
# All of these are rebuilt by rebuild_all.tcl from the sources.
hft.cache/
hft.gen/
hft.hw/
hft.ip_user_files/
hft.runs/
hft.sim/

# --- Synthesis / implementation checkpoints ------------------
# Large binaries (tens of MB) with no value in version control.
*.dcp
*.rpx

# --- Block design generated output --------------------------
# The .bd itself is source and is kept; everything derived is not.
hft.srcs/sources_1/bd/*/hdl/
hft.srcs/sources_1/bd/*/ip/*/sim/
hft.srcs/sources_1/bd/*/ip/*/synth/
hft.srcs/sources_1/bd/*/hw_handoff/
hft.srcs/sources_1/bd/*/ipshared/

# --- Simulation output --------------------------------------
xsim.dir/
*.wdb
*.wcfg
*.vcd
*.pb

# --- Hardware handoff ---------------------------------------
# The exported .xsa is regenerable from this project, but keeping
# the top-level copy lets the firmware repository build its Vitis
# platform without running Vivado. Nested copies are excluded.
*.xsa
!/mlp_system_wrapper.xsa

# --- Superseded scripts -------------------------------------
# run_synth.tcl and build_bitstream.tcl were replaced by
# rebuild_all.tcl; the originals are kept locally only.
_eski_tcl/

# --- Tooling and editor -------------------------------------
.claude/
.vscode/
.idea/
*.swp
*~
Thumbs.db
.DS_Store

# --- Python ------------------------------------------------
__pycache__/
*.pyc
